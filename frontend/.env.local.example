NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-only — required for admin actions (invites) and the live Systemstatus panel
SUPABASE_SERVICE_KEY=your-service-role-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Öffentliche Basis-URL der App — landet in Einladungs-/Passwort-Mails.
# Muss exakt der Supabase "Site URL" bzw. einem Eintrag der Redirect-Allowlist
# entsprechen, sonst verwirft Supabase das redirectTo und die eingeladene
# Person landet nicht auf /set-password.
NEXT_PUBLIC_SITE_URL=https://www.tracebuild.ch

# Admin-Kosten: Umrechnung analyses.cost_usd -> CHF (0.1-10). Ohne/ungueltig: Fallback 0.80 (lib/admin-currency.ts)
USD_CHF_RATE=0.80

# ÖREB-Webservices: Die Basis-URLs aller 26 Kantone stehen im Code (lib/oereb/service-quirks.ts).
# OEREB_BASE_URL_<KT> ist optional und nur ein Override (AG, AI, AR, BE, BL, BS, FR, GE, GL, GR, JU,
# LU, NE, NW, OW, SG, SH, SO, SZ, TG, TI, UR, VD, VS, ZG, ZH). Leer ist kein Fehler.
# OEREB_BASE_URL_SG=https://oereb.geo.sg.ch/ktsg/wsgi/oereb
# OEREB_BASE_URL_AR=https://oereb.ar.ch/ktar/wsgi/oereb

# Optionaler Zugang für Dienste, die den Auszug nur Registrierten liefern (bisher NE).
# Format "Header-Name: Wert". Wird nur an den Host der Basis-URL gesendet und nie geloggt.
# OEREB_NE_AUTH_HEADER=

# Admin «Tools & Dienste» (/admin/tools). Alles optional: Ohne Wert zeigt die Karte «Nicht eingerichtet»
# und ruft den Dienst nicht auf. Nur serverseitig, nie mit NEXT_PUBLIC_ versehen.
# Vercel: Token mit Lesezugriff, Projekt-ID; Team-ID nur für die Abrechnung.
MONITORING_VERCEL_TOKEN=
MONITORING_VERCEL_PROJECT_ID=
MONITORING_VERCEL_TEAM_ID=
# GitHub: Fine-grained Token (Actions, Pull Requests, Dependabot alerts, Contents: lesen). Repo Default jonasjud87-cloud/Tracebuild.
MONITORING_GITHUB_TOKEN=
MONITORING_GITHUB_REPO=
# Resend: API-Key mit Vollzugriff (für /usage und /domains).
MONITORING_RESEND_API_KEY=
# Supabase Management API (Personal Access Token), optional zusätzlich zu den DB-Kennzahlen.
MONITORING_SUPABASE_PAT=
