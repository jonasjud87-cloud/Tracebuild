NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-only — required for admin actions (invites) and the live Systemstatus panel
SUPABASE_SERVICE_KEY=your-service-role-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Öffentliche Basis-URL der App — landet in Einladungs-/Passwort-Mails.
# Muss exakt der Supabase "Site URL" bzw. einem Eintrag der Redirect-Allowlist
# entsprechen, sonst verwirft Supabase das redirectTo und die eingeladene
# Person landet nicht auf /set-password.
NEXT_PUBLIC_SITE_URL=https://tracebuild.vercel.app

# ÖREB-Webservice (pro Kanton eigene Basis-URL, swisstopo-Weisung v2). Leer = kein Abruf,
# der Auszug endet mit status 'unreachable'. SG verifiziert am 12.09.2026 (pyramid_oereb).
OEREB_BASE_URL_SG=https://oereb.geo.sg.ch/ktsg/wsgi/oereb
