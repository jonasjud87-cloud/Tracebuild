NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-only — required for admin actions (invites) and the live Systemstatus panel
SUPABASE_SERVICE_KEY=your-service-role-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Öffentliche Basis-URL der App — landet in Einladungs-/Passwort-Mails.
# Muss exakt der Supabase "Site URL" bzw. einem Eintrag der Redirect-Allowlist
# entsprechen, sonst verwirft Supabase das redirectTo und die eingeladene
# Person landet nicht auf /set-password.
NEXT_PUBLIC_SITE_URL=https://www.tracebuild.ch

# ÖREB-Webservices: Die Basis-URLs aller 26 Kantone stehen im Code (lib/oereb/service-quirks.ts).
# OEREB_BASE_URL_<KT> ist optional und nur ein Override (AG, AI, AR, BE, BL, BS, FR, GE, GL, GR, JU,
# LU, NE, NW, OW, SG, SH, SO, SZ, TG, TI, UR, VD, VS, ZG, ZH). Leer ist kein Fehler.
# OEREB_BASE_URL_SG=https://oereb.geo.sg.ch/ktsg/wsgi/oereb
# OEREB_BASE_URL_AR=https://oereb.ar.ch/ktar/wsgi/oereb

# Optionaler Zugang für Dienste, die den Auszug nur Registrierten liefern (bisher NE).
# Format "Header-Name: Wert". Wird nur an den Host der Basis-URL gesendet und nie geloggt.
# OEREB_NE_AUTH_HEADER=
